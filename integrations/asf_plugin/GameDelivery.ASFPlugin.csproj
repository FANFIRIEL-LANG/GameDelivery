<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup>
    <ASF_BIN_DIR Condition="'$(ASF_BIN_DIR)' == ''">$(MSBuildThisFileDirectory)../../ASF</ASF_BIN_DIR>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASF Windows distributions provide Newtonsoft.Json 13.0.0.0 at runtime; use NuGet only for compile-time metadata. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" IncludeAssets="compile" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ArchiSteamFarm">
      <HintPath>$(ASF_BIN_DIR)/ArchiSteamFarm.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SteamKit2">
      <HintPath>$(ASF_BIN_DIR)/SteamKit2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Composition.AttributedModel">
      <HintPath>$(ASF_BIN_DIR)/System.Composition.AttributedModel.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
