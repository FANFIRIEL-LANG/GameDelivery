<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Version>1.0.2</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <PropertyGroup>
    <ASF_BIN_DIR Condition="'$(ASF_BIN_DIR)' == ''">$(MSBuildThisFileDirectory)../../ASF</ASF_BIN_DIR>
  </PropertyGroup>
  <!-- JSON uses the System.Text.Json implementation included in the .NET 10 shared framework. -->
  <ItemGroup>
    <Reference Include="AngleSharp">
      <HintPath>$(ASF_BIN_DIR)/AngleSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ArchiSteamFarm">
      <HintPath>$(ASF_BIN_DIR)/ArchiSteamFarm.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SteamKit2">
      <HintPath>$(ASF_BIN_DIR)/SteamKit2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Composition.AttributedModel">
      <HintPath>$(ASF_BIN_DIR)/System.Composition.AttributedModel.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
