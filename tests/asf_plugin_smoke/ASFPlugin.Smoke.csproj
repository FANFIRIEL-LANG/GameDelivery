<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ASF_BIN_DIR Condition="'$(ASF_BIN_DIR)' == ''">$(MSBuildThisFileDirectory)../../.asf-bin</ASF_BIN_DIR>
    <PLUGIN_DLL Condition="'$(PLUGIN_DLL)' == ''">$(MSBuildThisFileDirectory)../../integrations/asf_plugin/bin/Release/net10.0/GameDelivery.ASFPlugin.dll</PLUGIN_DLL>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../integrations/asf_plugin/CommandArgumentParser.cs" Link="CommandArgumentParser.cs" />
    <Reference Include="ArchiSteamFarm">
      <HintPath>$(ASF_BIN_DIR)/ArchiSteamFarm.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SteamKit2">
      <HintPath>$(ASF_BIN_DIR)/SteamKit2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Composition.AttributedModel">
      <HintPath>$(ASF_BIN_DIR)/System.Composition.AttributedModel.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Composition.Convention">
      <HintPath>$(ASF_BIN_DIR)/System.Composition.Convention.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Composition.Hosting">
      <HintPath>$(ASF_BIN_DIR)/System.Composition.Hosting.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Composition.Runtime">
      <HintPath>$(ASF_BIN_DIR)/System.Composition.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Composition.TypedParts">
      <HintPath>$(ASF_BIN_DIR)/System.Composition.TypedParts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GameDelivery.ASFPlugin">
      <HintPath>$(PLUGIN_DLL)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
